---
import Collapsible from './Collapsible.astro'

import { STATUS_PAGE_URL } from '../lib/config'

interface Props {
	num: number
	name: string
	codename?: string
	desc: string
	href?: string
	repo?: string
	wip?: boolean
	monitor?: string
	logo?: string
	tech?: string[]
	labels?: {
		visit?: string
		wip?: string
		source?: string
		stack?: string
		links?: string
		toggle?: string
	}
}

const {
	num,
	name,
	codename,
	desc,
	href,
	repo,
	wip = false,
	monitor,
	logo,
	tech,
	labels,
} = Astro.props

const L = {
	visit: labels?.visit ?? 'Visit',
	wip: labels?.wip ?? 'WIP',
	source: labels?.source ?? 'Source',
	stack: labels?.stack ?? 'Stack',
	links: labels?.links ?? 'Links',
	toggle: labels?.toggle ?? 'Toggle project details',
}

const numStr = String(num).padStart(2, '0')
---

<Collapsible
	groupName="project"
	toggleLabel={L.toggle}
	rootClass="project-row"
	headerClass="flex items-center gap-4"
	dataAttrs={{ 'data-monitor': monitor }}
>
	<Fragment slot="header">
		<span class="text-foreground/50 w-6 shrink-0 font-mono text-xs"
			>{numStr}</span
		>

		<div class="flex min-w-0 flex-1 items-baseline gap-3">
			<span class="text-foreground truncate text-sm font-medium">{name}</span>
			{
				codename && (
					<span class="eyebrow-mono text-foreground/50 shrink-0 lowercase!">
						[{codename}]
					</span>
				)
			}
		</div>

		{
			monitor && (
				<a
					href={STATUS_PAGE_URL}
					data-ready="false"
					target="_blank"
					rel="noopener noreferrer"
					class="project-status-link eyebrow-mono text-foreground/60 hover:text-foreground border-foreground/15 hover:border-foreground/30 active:text-foreground hidden items-center gap-1.5 rounded-full border px-2.5 py-1 whitespace-nowrap transition-colors sm:inline-flex"
					style="display:none;"
				>
					<span class="project-status-dot bg-foreground/30 h-1.5 w-1.5 rounded-full" />
					<span class="project-status-label" />
					<svg
						width="10"
						height="10"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M7 7h10v10" />
						<path d="M7 17 17 7" />
					</svg>
				</a>
			)
		}

		{
			wip && (
				<span class="text-accent border-accent/40 shrink-0 rounded-full border px-2 py-0.5 text-[10px] tracking-widest uppercase">
					{L.wip}
				</span>
			)
		}
	</Fragment>

	<Fragment slot="body">
		<div class="flex items-start gap-4 px-4 py-4">
			{
				logo && (
					<svg
						class="project-logo text-foreground/80 h-12 w-12 shrink-0"
						aria-hidden="true"
					>
						<use href={logo} />
					</svg>
				)
			}
			<div class="flex min-w-0 flex-1 flex-col gap-3">
				<p class="text-foreground/80 text-sm leading-relaxed">
					{desc}
				</p>

				{
					tech && tech.length > 0 && (
						<div class="flex flex-col gap-1.5">
							<span class="eyebrow-semibold text-foreground/50">{L.stack}</span>
							<div class="flex flex-wrap gap-1.5">
								{tech.map((t) => (
									<span class="eyebrow-mono text-foreground/60 border-foreground/15 rounded-full border px-2 py-0.5">
										{t}
									</span>
								))}
							</div>
						</div>
					)
				}

				{
					(href || repo) && (
						<div class="flex flex-col gap-1.5">
							<span class="eyebrow-semibold text-foreground/50">{L.links}</span>
							<div class="flex flex-col gap-1.5">
								{href && (
									<div class="flex items-baseline gap-2 text-xs">
										<a
											href={href}
											target="_blank"
											rel="noopener noreferrer"
											class="text-foreground/80 hover:text-accent inline-flex shrink-0 items-center gap-1 font-medium underline transition-colors"
										>
											{L.visit}
											<svg
												width="10"
												height="10"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="M7 7h10v10" />
												<path d="M7 17 17 7" />
											</svg>
										</a>
									</div>
								)}
								{repo && (
									<div class="flex items-baseline gap-2 text-xs">
										<a
											href={repo}
											target="_blank"
											rel="noopener noreferrer"
											class="text-foreground/80 hover:text-accent inline-flex shrink-0 items-center gap-1 font-medium underline transition-colors"
										>
											{L.source}
											<svg
												width="10"
												height="10"
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											>
												<path d="M7 7h10v10" />
												<path d="M7 17 17 7" />
											</svg>
										</a>
									</div>
								)}
							</div>
						</div>
					)
				}

				{
					monitor && (
						<a
							href={STATUS_PAGE_URL}
							data-ready="false"
							target="_blank"
							rel="noopener noreferrer"
							class="project-status-link eyebrow-mono text-foreground/60 hover:text-foreground border-foreground/15 hover:border-foreground/30 active:text-foreground inline-flex items-center gap-1.5 self-start rounded-full border px-2.5 py-1 whitespace-nowrap transition-colors sm:hidden"
							style="display:none;"
						>
							<span class="project-status-dot bg-foreground/30 h-1.5 w-1.5 rounded-full" />
							<span class="project-status-label" />
							<svg
								width="10"
								height="10"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M7 7h10v10" />
								<path d="M7 17 17 7" />
							</svg>
						</a>
					)
				}
			</div>
		</div>
	</Fragment>
</Collapsible>
